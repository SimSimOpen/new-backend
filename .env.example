# Deployment environment contract for /opt/backend/simsim/.env
# (or the ENV_FILE repository secret, which the workflow writes to that path).
#
# Copy and fill in real values. Never commit the copy: .env is gitignored.
#
# Every name below is read by src/main/resources/application.properties. Names
# must match exactly - Spring's relaxed binding does not rescue a misspelling in
# a placeholder default, it just silently falls back to the localhost value.
#
# Hostnames are Docker-network names: this container joins the external "simsim"
# network, so localhost here means the container itself, not the VPS.

# --- postgres ---
# schema is applied by Hibernate on every boot (ddl-auto=update); there is no
# Liquibase/Flyway in this project, so a bad entity change reaches prod directly
SPRING_DATASOURCE_URL=jdbc:postgresql://<db-host>:5432/sim-sim
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# --- auth ---
# base64, at least 32 bytes. Empty does not stop startup: it makes every
# protected route answer 403 and signing throw WeakKeyException.
JWT_SECRET=
# consumed only on the first boot against a database with no "admin" user
APP_ADMIN_PASSWORD=

# --- minio ---
# empty access/secret keys abort startup with
#   IllegalArgumentException: AccessKey and SecretKey must not be empty
MINIO_URL=http://<minio-host>:9000
MINIO_ENDPOINT=http://<minio-host>:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# the PUBLIC url clients use to fetch media, not the internal one - it is baked
# into the URLs returned by the product API
APP_MEDIA_BASE_URL=https://api.simsim.fit

# --- redis (OTP storage + SSE) ---
REDIS_HOST=<redis-host>
REDIS_PORT=6379
# prod redis is authenticated; these bind straight onto spring.data.redis.*
SPRING_DATA_REDIS_USERNAME=
SPRING_DATA_REDIS_PASSWORD=

# --- sms ---
# log = print the OTP to stdout and never text anyone (safe default)
# twilio = real messages; a Twilio trial account can only message verified numbers
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_TRIAL_NUMBER=

# --- operator notification feed ---
# Absent or false: the net.jemsit.notify module is skipped entirely - no beans, no
# tables, no /notify/** routes. This is the shipped default, so deploying without
# touching this file changes nothing.
NOTIFY_ENABLED=
# Shared secret for every /notify endpoint, sent as "Authorization: Bearer <token>"
# (or ?token=). Generate with: openssl rand -hex 32
#
# Set both in ONE edit of the ENV_FILE secret. The deploy job rewrites
# /opt/backend/simsim/.env from that secret on every run, so a hand-edit on the VPS
# is silently reverted by the next deploy.
#
# NOTIFY_ENABLED=true with this left blank would expose POST /notify/publish to the
# whole internet - anyone could push a card to a phone that trusts this app. The app
# refuses to open that way: it forces notify.enabled back to false and prints why.
NOTIFY_TOKEN=
# After the deploy that enables it, this must print 401. A 200 means the token is
# blank and the relay is open:
#   curl -s -o /dev/null -w '%{http_code}' https://api.simsim.fit/notify/health
# The first enabled boot creates notify_outbox and notify_device in the sim-sim
# database. The module never ALTERs them, so a later module version that changes the
# schema would be missed here silently.

# Renamed or dropped from the old notification-service .env:
#   TWILIO_FROM_PHONE -> TWILIO_TRIAL_NUMBER
#   SPECIAL_NUMBERS, JIMI_NUMBER -> unused, no longer read by anything
#   REDIS_USERNAME/REDIS_PASSWORD -> SPRING_DATA_REDIS_USERNAME/SPRING_DATA_REDIS_PASSWORD
